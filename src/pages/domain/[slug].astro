---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DomainCard from '../../components/DomainCard.astro';
import { domains, fqdn, formatPrice, tierOf } from '../../data/domains';
import { EMAIL, SITE } from '../../data/site';

export function getStaticPaths() {
  return domains.map((domain) => ({ params: { slug: domain.slug }, props: { domain } }));
}

const { domain } = Astro.props;
const full = fqdn(domain);
const tier = tierOf(domain.price);
const similar = domains.filter((d) => d.category === domain.category && d.slug !== domain.slug).slice(0, 2);
---

<Layout
  title={`${full} | Premium Domain for Sale | desigr`}
  description={`${full} is ${domain.price == null ? 'available by offer' : `available at ${formatPrice(domain.price)}`}. ${domain.summary}`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: full,
    description: domain.summary,
    category: domain.category,
    url: `${SITE}/domain/${domain.slug}/`,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      ...(domain.price != null ? { price: String(domain.price) } : {}),
      availability: 'https://schema.org/InStock',
      seller: { '@type': 'Organization', name: 'desigr.monster', email: EMAIL },
    },
  }}
>
  <Header />
  <main>
    <article class="mx-auto grid max-w-6xl gap-12 px-5 py-14 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="text-xs uppercase tracking-[0.16em] text-muted dark:text-muted-dark">
          {domain.category} · {domain.length} letters · {domain.tld} for sale
        </p>
        <h1 class="display mt-3 text-5xl sm:text-7xl">
          {domain.name}<span class="text-accent dark:text-accent-dark">{domain.tld}</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg text-muted dark:text-muted-dark">{domain.summary}</p>
        <h2 class="mt-10 text-sm uppercase tracking-[0.16em] text-muted dark:text-muted-dark">Why this name</h2>
        <ul class="mt-3 space-y-3">{domain.why.map((item) => <li>{item}</li>)}</ul>
        <h2 class="mt-10 text-sm uppercase tracking-[0.16em] text-muted dark:text-muted-dark">How it is priced</h2>
        <p class="mt-3 max-w-xl text-muted dark:text-muted-dark">{domain.comparable}</p>
      </div>
      <aside class="h-fit rounded-2xl border border-line bg-surface p-6 dark:border-line-dark dark:bg-surface-dark">
        <p class="text-sm text-muted dark:text-muted-dark">Asking price</p>
        <p class="display mt-1 text-5xl tabular-nums">{formatPrice(domain.price)}</p>
        <p class="mt-2 text-sm text-muted dark:text-muted-dark">One name. {domain.views} views this quarter. Escrow required.</p>
        <div class="mt-6 flex flex-col gap-3">
          {tier !== 'inquire' && (
            <a href={`mailto:${EMAIL}?subject=${encodeURIComponent('Buy now: ' + full)}`} class="inline-flex h-12 items-center justify-center rounded-lg bg-ink text-sm text-bg dark:bg-ink-dark dark:text-bg-dark">
              {tier === 'buy' ? 'Buy now' : 'Start purchase'}
            </a>
          )}
          <a href={`mailto:${EMAIL}?subject=${encodeURIComponent('Offer: ' + full)}`} class="inline-flex h-12 items-center justify-center rounded-lg border border-line text-sm dark:border-line-dark">Make offer</a>
          <a href={`mailto:${EMAIL}?subject=${encodeURIComponent('Agent: ' + full)}`} class="inline-flex h-12 items-center justify-center text-sm text-muted underline dark:text-muted-dark">Contact agent</a>
        </div>
        <form id="offer" class="mt-6 space-y-3 border-t border-line pt-6 dark:border-line-dark">
          <h2 class="text-sm">Write the offer here</h2>
          <input name="name" required placeholder="Name" class="field" />
          <input name="email" type="email" required placeholder="Email" class="field" />
          <input name="amount" inputmode="numeric" required placeholder="Offer in USD" class="field" />
          <textarea name="note" rows="3" placeholder="Intended use" class="field min-h-24 py-3"></textarea>
          <button type="submit" class="h-12 w-full rounded-lg bg-accent text-sm text-surface">Submit offer</button>
          <p id="offer-note" hidden class="text-sm">Saved in this browser. Email {EMAIL} for a same-day reply — the form does not send mail by itself.</p>
        </form>
      </aside>
    </article>
    {similar.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pb-16">
        <h2 class="display text-3xl">Similar names</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {similar.map((item) => <DomainCard domain={item} />)}
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<script define:vars={{ full }}>
  const form = document.querySelector('#offer');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const offers = JSON.parse(localStorage.getItem('desigr-offers') || '[]');
    offers.push({
      domain: full,
      name: String(data.get('name')),
      email: String(data.get('email')),
      amount: String(data.get('amount')),
      note: String(data.get('note') || ''),
      at: new Date().toISOString(),
    });
    localStorage.setItem('desigr-offers', JSON.stringify(offers));
    form.querySelector('#offer-note')?.removeAttribute('hidden');
  });
</script>
