---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | desigr.monster" description="The page you requested is not available on desigr.monster." noindex={true}>
  <main class="flex min-h-dvh flex-col items-center justify-center px-6 text-center">
    <p class="text-sm uppercase tracking-[0.2em] text-muted">404</p>
    <h1 class="display mt-4 text-4xl">This page does not exist</h1>
    <a href="/" class="mt-8 inline-flex h-12 items-center rounded-full border border-line px-6 text-sm dark:border-line-dark">Back home</a>
  </main>
</Layout>
