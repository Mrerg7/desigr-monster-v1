---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DomainCard from '../components/DomainCard.astro';
import { CATEGORIES, domains, TLDS } from '../data/domains';
---

<Layout
  title="Domain marketplace | Premium names for sale | desigr.monster"
  description="Browse premium domain names for sale: brandable, geo, technology, and exact-match commercial domains. Filter by price, TLD, and keyword."
>
  <Header />
  <main class="mx-auto max-w-6xl px-5 py-14">
    <h1 class="display text-5xl">Portfolio</h1>
    <p class="mt-3 max-w-2xl text-muted dark:text-muted-dark">
      Buy .monster domains and a short list of exact-match names. Every listing is owned outright and can transfer this week.
    </p>
    <form id="filters" class="mt-8 grid gap-3 lg:grid-cols-[1.4fr_1fr_0.8fr]">
      <input id="q" placeholder="Search keyword, TLD, or name" class="h-12 rounded-lg border border-line bg-surface px-3 text-base dark:border-line-dark dark:bg-surface-dark" />
      <select id="tld" class="h-12 rounded-lg border border-line bg-surface px-3 text-base dark:border-line-dark dark:bg-surface-dark">
        {TLDS.map((tld) => <option value={tld}>{tld === 'all' ? 'Any extension' : tld}</option>)}
      </select>
      <label class="flex h-12 items-center gap-3 rounded-lg border border-line px-3 text-sm dark:border-line-dark">
        Under
        <input id="max" type="range" min="2000" max="30000" step="1000" value="30000" class="w-full" />
        <span id="max-label" class="tabular-nums">$30k</span>
      </label>
    </form>
    <div class="mt-4 flex gap-2 overflow-x-auto" role="tablist" aria-label="Category">
      {CATEGORIES.map((item) => (
        <button type="button" data-cat={item.id} class="cat h-12 shrink-0 rounded-full border border-line px-4 text-sm dark:border-line-dark" aria-pressed={item.id === 'all' ? 'true' : 'false'}>
          {item.label}
        </button>
      ))}
    </div>
    <p id="count" class="mt-6 text-sm text-muted dark:text-muted-dark">{domains.length} names</p>
    <div id="grid" class="mt-4 grid gap-4 sm:grid-cols-2">
      {domains.map((domain) => (
        <div data-card data-cat={domain.category} data-tld={domain.tld} data-price={domain.price ?? 999999} data-text={`${domain.name}${domain.tld} ${domain.keywords.join(' ')} ${domain.summary}`.toLowerCase()}>
          <DomainCard domain={domain} />
        </div>
      ))}
    </div>
    <p id="empty" hidden class="mt-6">Nothing in that slice. Widen the price or clear the search.</p>
  </main>
  <Footer />
</Layout>

<script>
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const tld = document.querySelector<HTMLSelectElement>('#tld')!;
  const max = document.querySelector<HTMLInputElement>('#max')!;
  const maxLabel = document.querySelector('#max-label')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const count = document.querySelector('#count')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;
  let cat = 'all';

  function apply() {
    const query = q.value.trim().toLowerCase();
    const cap = Number(max.value);
    maxLabel.textContent = `$${Math.round(cap / 1000)}k`;
    let shown = 0;
    for (const card of cards) {
      const ok =
        (cat === 'all' || card.dataset.cat === cat) &&
        (tld.value === 'all' || card.dataset.tld === tld.value) &&
        Number(card.dataset.price) <= cap &&
        (!query || (card.dataset.text || '').includes(query));
      card.hidden = !ok;
      if (ok) shown += 1;
    }
    count.textContent = `${shown} names`;
    empty.hidden = shown !== 0;
  }

  document.querySelectorAll<HTMLButtonElement>('.cat').forEach((button) => {
    button.addEventListener('click', () => {
      cat = button.dataset.cat || 'all';
      document.querySelectorAll('.cat').forEach((el) => {
        const on = el === button;
        el.setAttribute('aria-pressed', on ? 'true' : 'false');
        el.classList.toggle('bg-ink', on);
        el.classList.toggle('text-bg', on);
      });
      apply();
    });
  });
  q.addEventListener('input', apply);
  tld.addEventListener('change', apply);
  max.addEventListener('input', apply);
</script>
