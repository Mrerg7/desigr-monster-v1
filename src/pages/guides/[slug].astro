---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { guides } from '../../data/guides';

export function getStaticPaths() {
  return guides.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
---
<Layout
  title={`${article.title} | desigr.monster`}
  description={article.description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    author: { '@type': 'Organization', name: 'desigr.monster' },
  }}
>
  <Header />
  <article class="mx-auto max-w-2xl px-5 py-14">
    <a href="/guides/" class="text-sm text-muted dark:text-muted-dark">Guides</a>
    <h1 class="display mt-4 text-5xl">{article.title}</h1>
    <div class="mt-8 space-y-5 leading-relaxed">
      {article.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </article>
  <Footer />
</Layout>
